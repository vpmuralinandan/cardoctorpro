# ==============================================================================
# Car Doctor Pro - Environment Configuration Variables
# Rename this file to .env or export these variables in your deployment environment
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL 8+)
# Note: Defaults to embedded H2 with MySQL mode for instant local development
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/cardoctor?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_secure_mysql_password
SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver

# Security JWT Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# AI Provider Configuration (Optional)
# Supported providers: gemini, openai, or fallback (rule-based expert engine)
AI_PROVIDER=fallback
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/
AI_RATE_LIMIT_PER_MINUTE=30
